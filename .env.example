# PassPortIQ v2 — Environment Configuration Example
# Copy to .env and adjust for your deployment environment.

# Application environment (development | test | production)
PASSPORTIQ_ENV=development

# Server bind configuration
PASSPORTIQ_HOST=127.0.0.1
PASSPORTIQ_PORT=8000

# Narrow CORS allowed origins (comma-separated)
PASSPORTIQ_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload & Image Security Limits
PASSPORTIQ_MAX_UPLOAD_BYTES=10485760
PASSPORTIQ_MIN_IMAGE_WIDTH=300
PASSPORTIQ_MIN_IMAGE_HEIGHT=200
PASSPORTIQ_MAX_IMAGE_WIDTH=6000
PASSPORTIQ_MAX_IMAGE_HEIGHT=6000
PASSPORTIQ_MAX_IMAGE_PIXELS=20000000
PASSPORTIQ_OCR_MAX_DIMENSION=2200

# OCR Engine Configuration
# Primary engine: "rapidocr" (RapidOCR + ONNX Runtime)
# Optional fallback engine: "tesseract" (only used when explicitly enabled or selected)
PASSPORTIQ_OCR_PRIMARY_ENGINE=rapidocr
PASSPORTIQ_OCR_ALLOW_TESSERACT_FALLBACK=false
PASSPORTIQ_OCR_TIMEOUT_SECONDS=15.0

# Frontend API Base URL (used by Vite)
VITE_API_BASE_URL=http://localhost:8000
